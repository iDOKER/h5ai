# Prevent PHP execution in cache directory
<FilesMatch "\.ph(p|tml)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Prevent directory listing
Options -Indexes
